<section class="py-6">
  <.breadcrumbs>
    <:breadcrumb label={gettext("Dashboard")} href={~p"/"} />
  </.breadcrumbs>

  <div id="dashboard-charts" phx-hook="ChartTooltip" class="grid grid-cols-12 gap-6 mt-6">
    <div class="col-span-12">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="bg-base-200 px-4 py-3 border-b border-base-300 rounded-t-2xl">
          <h2 class="card-title text-base m-0">
            {gettext("Banks")}
          </h2>
        </div>
        <div class="card-body p-6 chart-container">
          <% # sobelow_skip ["XSS.Raw"] %>
          {raw(Conta.Stats.graph_banks(@currency))}
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-6">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="bg-base-200 px-4 py-3 border-b border-base-300 rounded-t-2xl">
          <h2 class="card-title text-base m-0">
            {gettext("Outcome")}
          </h2>
        </div>
        <div class="card-body p-6 chart-container">
          <% # sobelow_skip ["XSS.Raw"] %>
          {raw(Conta.Stats.graph_outcome(@currency))}
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-6">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="bg-base-200 px-4 py-3 border-b border-base-300 rounded-t-2xl">
          <h2 class="card-title text-base m-0">
            {gettext("Income")}
          </h2>
        </div>
        <div class="card-body p-6 chart-container">
          <% # sobelow_skip ["XSS.Raw"] %>
          {raw(Conta.Stats.graph_income(@currency))}
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-6">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="bg-base-200 px-4 py-3 border-b border-base-300 rounded-t-2xl">
          <h2 class="card-title text-base m-0">
            {gettext("Profits and Loses")}
          </h2>
        </div>
        <div class="card-body p-6 chart-container">
          <% # sobelow_skip ["XSS.Raw"] %>
          {raw(Conta.Stats.graph_pnl(@currency, 6))}
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-6">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="bg-base-200 px-4 py-3 border-b border-base-300 rounded-t-2xl">
          <h2 class="card-title text-base m-0">
            <% # sobelow_skip ["XSS.Raw"] %>
            {raw(gettext("Patrimony"))}
          </h2>
        </div>
        <div class="card-body p-6 chart-container">
          <% # sobelow_skip ["XSS.Raw"] %>
          {raw(Conta.Stats.graph_patrimony(@currency))}
        </div>
      </div>
    </div>
  </div>
</section>
